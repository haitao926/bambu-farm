DATABASE_URL="file:./dev.db"

PRINTER_ADAPTER=developer_mode
PRINTER_MQTT_PORT=8883
PRINTER_FTPS_PORT=990
PRINTER_MQTT_TIMEOUT_MS=10000
PRINTER_FTPS_TIMEOUT_MS=20000
PRINTER_CONNECT_TIMEOUT_MS=10000
PRINTER_TELEMETRY_ENABLED=true
PRINTER_TLS_CA_PATH=src/printer-adapters/certs/bbl-ca.pem
PRINTER_UPLOAD_REMOTE_DIR=/

PRINTER_TEST_IP=192.168.1.100
PRINTER_TEST_ACCESS_CODE=12345678
PRINTER_TEST_SERIAL=00M00A00000
PRINTER_TEST_LOCAL_FILE=uploads/example.gcode
PRINTER_TEST_REMOTE_FILENAME=example.gcode
